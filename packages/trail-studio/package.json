{
	"name": "@juicerq/trail-studio",
	"version": "0.1.3",
	"description": "Local readonly Studio for Trail SQLite event stores.",
	"license": "MIT",
	"bin": {
		"trail-studio": "./src/cli.ts"
	},
	"files": [
		"src",
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vite build",
		"check": "tsgo -p tsconfig.json",
		"dev": "vite --host 127.0.0.1",
		"lint": "oxlint . --no-error-on-unmatched-pattern",
		"lint:fix": "oxlint --fix . --no-error-on-unmatched-pattern",
		"format": "oxfmt . '!dist/**'",
		"format:check": "oxfmt --check . '!dist/**'",
		"test": "bun test",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.7.6",
		"@tanstack/react-query": "^5.90.10",
		"@tanstack/react-router": "^1.135.0",
		"@vitejs/plugin-react": "^5.1.1",
		"hono": "^4.12.14",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"vite": "^7.2.4",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260422.1",
		"bun-types": "^1.3.13",
		"oxfmt": "^0.46.0",
		"oxlint": "^1.61.0"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
